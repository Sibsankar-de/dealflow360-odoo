PORT=5000
NODE_ENV=development
APP_DEBUG=true

CORS_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=root
DB_NAME=dealflow
DB_SSL=false

# JWT and Tokens
ACCESS_TOKEN_SECRET=dealflow360_access_token_secret_key_change_in_production
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=10
ACCESS_TOKEN_COOKIE_EXPIRY=15
REFRESH_TOKEN_COOKIE_EXPIRY=10

# RabbitMQ
RABBITMQ_CONNECTION_URI=amqp://admin:admin@localhost:5672

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_PRODUCTS_INDEX=dealflow_products
ELASTICSEARCH_USERS_INDEX=dealflow_users
