enum AuthProvider {
  LOCAL
  GOOGLE
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  userName        String
  email           String       @unique
  password        String
  avatar          String?
  authBy          AuthProvider @default(LOCAL)
  isEmailVerified Boolean      @default(false)
  role            UserRole     @default(USER)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Auth Relations
  refreshTokens      RefreshToken[]
  authTokens         AuthToken[]
  verificationTokens VerificationToken[]

  // Company Relations
  ownedCompanies     Company[]           @relation("CompanyOwner")
  companyUsers       CompanyUser[]

  // Deal Relations
  dealsAsCustomer       Deal[]                 @relation("DealCustomer")
  dealsAsSalesRep       Deal[]                 @relation("DealSalesRep")

  // Quotation Relations
  createdQuotations     Quotation[]            @relation("QuotationSalesRep")
  receivedQuotations    Quotation[]            @relation("QuotationCustomer")
  createdRevisions      QuotationRevision[]    @relation("RevisionCreator")
  approvedNegotiations  Negotiation[]          @relation("NegotiationApprover")
  rejectedNegotiations  Negotiation[]          @relation("NegotiationRejecter")

  // Sales Order & Invoice Relations
  salesOrdersAsCustomer SalesOrder[]           @relation("SalesOrderCustomer")
  salesOrdersAsSalesRep SalesOrder[]           @relation("SalesOrderSalesRep")
  invoicesAsCustomer    Invoice[]              @relation("InvoiceCustomer")

  @@index([email])
  @@map("users")
}
