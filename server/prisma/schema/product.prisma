enum ProductType {
  ONE_TIME
  RECURRING
}

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  companyId   String      @db.Uuid
  name        String
  description String?
  price       Decimal     @db.Decimal(12, 2)
  baseUnit    String      @default("UNIT") @map("base_unit")
  type        ProductType @default(ONE_TIME)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productStocks          ProductStock[]
  quotationItems         QuotationItem[]
  quotationRevisionItems QuotationRevisionItem[]
  negotiationItems       NegotiationItem[]
  discountTiers          ProductDiscountTier[]
  categories             CategoryProduct[]
  salesOrderItems        SalesOrderItem[]
  deliveryItems          DeliveryItem[]
  backorderItems         BackorderItem[]
  invoiceItems           InvoiceItem[]

  @@index([companyId])
  @@index([type])
  @@map("products")
}
