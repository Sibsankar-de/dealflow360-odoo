enum RevisionType {
  INITIAL
  SALES_COUNTER
  CUSTOMER_COUNTER
  FINAL
}

enum RevisionStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  SUPERSEDED
}

model QuotationRevision {
  id             String         @id @default(uuid()) @db.Uuid
  quotationId    String         @map("quotation_id") @db.Uuid
  revisionNo     Int            @map("revision_no")
  createdById    String         @map("created_by") @db.Uuid
  revisionType   RevisionType   @default(INITIAL) @map("revision_type")
  status         RevisionStatus @default(DRAFT)
  subtotal       Decimal        @db.Decimal(12, 2)
  discountAmount Decimal        @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal        @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount    Decimal        @map("total_amount") @db.Decimal(12, 2)
  customerNote   String?        @map("customer_note")
  internalNote   String?        @map("internal_note")
  createdAt      DateTime       @default(now()) @map("created_at")

  // Relations
  quotation           Quotation               @relation("QuotationRevisions", fields: [quotationId], references: [id], onDelete: Cascade)
  currentForQuotation Quotation?              @relation("CurrentQuotationRevision")
  creator             User                    @relation("RevisionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items               QuotationRevisionItem[]

  @@unique([quotationId, revisionNo])
  @@index([quotationId])
  @@index([createdById])
  @@index([status])
  @@index([revisionType])
  @@map("quotation_revisions")
}

model QuotationRevisionItem {
  id                  String       @id @default(uuid()) @db.Uuid
  quotationRevisionId String       @map("quotation_revision_id") @db.Uuid
  productId           String       @map("product_id") @db.Uuid
  quantity            Decimal      @db.Decimal(12, 2)
  unitPrice           Decimal      @map("unit_price") @db.Decimal(12, 2)
  discountType        DiscountType @default(PERCENTAGE) @map("discount_type")
  discountValue       Decimal      @default(0) @map("discount_value") @db.Decimal(12, 2)
  discountAmount      Decimal      @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxRate             Decimal      @default(0) @map("tax_rate") @db.Decimal(5, 2)
  finalUnitPrice      Decimal      @map("final_unit_price") @db.Decimal(12, 2)
  lineTotal           Decimal      @map("line_total") @db.Decimal(12, 2)

  // Relations
  revision QuotationRevision @relation(fields: [quotationRevisionId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([quotationRevisionId])
  @@index([productId])
  @@map("quotation_revision_items")
}
