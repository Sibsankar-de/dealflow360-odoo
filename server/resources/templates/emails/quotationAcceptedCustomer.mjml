<mjml>
  <mj-head>
    <mj-title>Quotation Accepted: {{ quotationNo }}</mj-title>
    <mj-font
      name="Inter"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
    <mj-attributes>
      <mj-all
        font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
      />
      <mj-text color="#374151" font-size="15px" line-height="1.6" padding="0" />
      <mj-section padding="0" />
      <mj-column padding="0" />
    </mj-attributes>
    <mj-style>
      .email-card {
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        border: 1px solid #dcfce7;
        border-radius: 12px;
        overflow: hidden;
      }
      .details-table {
        background-color: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 8px;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#F3F4F6">
    <mj-section padding="32px 24px 16px">
      <mj-column>
        <mj-text align="center" font-size="22px" font-weight="700" color="#1e293b">
          DealFlow360
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section
      css-class="email-card"
      background-color="#ffffff"
      padding="36px 32px"
    >
      <mj-column>
        <mj-text
          font-size="20px"
          font-weight="700"
          color="#16a34a"
          padding-bottom="16px"
        >
          ✅ Quotation Confirmed & Accepted
        </mj-text>

        <mj-text padding-bottom="12px">
          Hi <strong>{{ customerName }}</strong>,
        </mj-text>

        <mj-text padding-bottom="20px">
          Thank you! You have successfully accepted quotation <strong>#{{ quotationNo }}</strong> for <strong>{{ dealTitle }}</strong> from <strong>{{ companyName }}</strong>.
        </mj-text>

        <mj-table css-class="details-table" padding="16px 20px" line-height="1.5">
          <tr>
            <td style="padding: 6px 0; font-size: 13px; color: #166534; width: 40%">Quotation No</td>
            <td style="padding: 6px 0; font-size: 14px; font-weight: 600; color: #0f172a">{{ quotationNo }}</td>
          </tr>
          <tr>
            <td style="padding: 6px 0; font-size: 13px; color: #166534">Company</td>
            <td style="padding: 6px 0; font-size: 14px; color: #334155">{{ companyName }}</td>
          </tr>
          <tr>
            <td style="padding: 6px 0; font-size: 13px; color: #166534">Total Value</td>
            <td style="padding: 6px 0; font-size: 16px; font-weight: 700; color: #16a34a">{{ currency }} {{ totalAmount }}</td>
          </tr>
        </mj-table>

        <mj-spacer height="20px" />

        <mj-text font-size="14px" color="#475569" padding-bottom="16px">
          Our team is now preparing fulfillment and invoicing. You will receive updates as your order progresses through dispatch and delivery.
        </mj-text>

        <mj-spacer height="16px" />

        <mj-button
          background-color="#16a34a"
          color="#ffffff"
          font-size="15px"
          font-weight="600"
          border-radius="8px"
          padding="0"
          inner-padding="12px 28px"
          href="{{ portalLink }}"
          align="center"
        >
          Go to Customer Portal
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 24px 32px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#9CA3AF">
          &copy; {{ currentYear }} {{ appName }}. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
