<mjml>
  <mj-head>
    <mj-title>High Risk Escalation: {{ quotationNo }}</mj-title>
    <mj-font
      name="Inter"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
    <mj-attributes>
      <mj-all
        font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
      />
      <mj-text color="#374151" font-size="15px" line-height="1.6" padding="0" />
      <mj-section padding="0" />
      <mj-column padding="0" />
    </mj-attributes>
    <mj-style>
      .email-card {
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        border: 1px solid #fee2e2;
        border-radius: 12px;
        overflow: hidden;
      }
      .details-table {
        background-color: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 8px;
      }
      .badge-danger {
        display: inline-block;
        background-color: #fee2e2;
        color: #991b1b;
        padding: 4px 10px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 13px;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#F3F4F6">
    <mj-section padding="32px 24px 16px">
      <mj-column>
        <mj-text align="center" font-size="22px" font-weight="700" color="#1e293b">
          DealFlow360
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section
      css-class="email-card"
      background-color="#ffffff"
      padding="36px 32px"
    >
      <mj-column>
        <mj-text
          font-size="20px"
          font-weight="700"
          color="#dc2626"
          padding-bottom="16px"
        >
          🚨 High Risk Escalation to Finance
        </mj-text>

        <mj-text padding-bottom="12px">
          Hi <strong>{{ managerName }}</strong>,
        </mj-text>

        <mj-text padding-bottom="20px">
          Quotation <strong>#{{ quotationNo }}</strong> for customer <strong>{{ customerName }}</strong> has triggered a high-risk policy violation score and has been escalated for your financial evaluation and approval.
        </mj-text>

        <mj-table css-class="details-table" padding="16px 20px" line-height="1.5">
          <tr>
            <td style="padding: 6px 0; font-size: 13px; color: #7f1d1d; width: 40%">Quotation No</td>
            <td style="padding: 6px 0; font-size: 14px; font-weight: 600; color: #0f172a">{{ quotationNo }}</td>
          </tr>
          <tr>
            <td style="padding: 6px 0; font-size: 13px; color: #7f1d1d">Deal / Opportunity</td>
            <td style="padding: 6px 0; font-size: 14px; color: #334155">{{ dealTitle }}</td>
          </tr>
          <tr>
            <td style="padding: 6px 0; font-size: 13px; color: #7f1d1d">Sales Representative</td>
            <td style="padding: 6px 0; font-size: 14px; color: #334155">{{ salesRepName }}</td>
          </tr>
          <tr>
            <td style="padding: 6px 0; font-size: 13px; color: #7f1d1d">Total Amount</td>
            <td style="padding: 6px 0; font-size: 15px; font-weight: 700; color: #0f172a">{{ currency }} {{ totalAmount }}</td>
          </tr>
          <tr>
            <td style="padding: 6px 0; font-size: 13px; color: #7f1d1d">Risk Classification</td>
            <td style="padding: 6px 0; font-size: 13px;">
              <span class="badge-danger">HIGH RISK (Score: {{ violationScore }}%)</span>
            </td>
          </tr>
        </mj-table>

        <mj-spacer height="16px" />

        <mj-text font-size="13px" color="#64748b" padding-bottom="16px">
          <strong>Note:</strong> {{ reason }}
        </mj-text>

        <mj-spacer height="16px" />

        <mj-button
          background-color="#dc2626"
          color="#ffffff"
          font-size="15px"
          font-weight="600"
          border-radius="8px"
          padding="0"
          inner-padding="12px 28px"
          href="{{ reviewLink }}"
          align="center"
        >
          Review & Approve in Workspace
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 24px 32px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#9CA3AF">
          &copy; {{ currentYear }} {{ appName }}. Finance Risk Workflow Notification.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
