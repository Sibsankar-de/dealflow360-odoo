<mjml>
  <mj-head>
    <mj-title>Fulfillment Ready: {{ quotationNo }}</mj-title>
    <mj-font
      name="Inter"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
    <mj-attributes>
      <mj-all
        font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
      />
      <mj-text color="#374151" font-size="15px" line-height="1.6" padding="0" />
      <mj-section padding="0" />
      <mj-column padding="0" />
    </mj-attributes>
    <mj-style>
      .email-card {
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
      }
      .details-table {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
      }
      .badge-ready {
        display: inline-block;
        background-color: #dbeafe;
        color: #1e40af;
        padding: 4px 10px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 13px;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#F3F4F6">
    <mj-section padding="32px 24px 16px">
      <mj-column>
        <mj-text align="center" font-size="22px" font-weight="700" color="#1e293b">
          DealFlow360
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section
      css-class="email-card"
      background-color="#ffffff"
      padding="36px 32px"
    >
      <mj-column>
        <mj-text
          font-size="20px"
          font-weight="700"
          color="#1e40af"
          padding-bottom="16px"
        >
          📦 Quotation Ready for Fulfillment & Invoicing
        </mj-text>

        <mj-text padding-bottom="12px">
          Hi <strong>{{ managerName }}</strong>,
        </mj-text>

        <mj-text padding-bottom="20px">
          The customer has accepted quotation <strong>#{{ quotationNo }}</strong>. The deal is now ready for stock verification, delivery dispatch, and partial/full invoicing.
        </mj-text>

        <mj-table css-class="details-table" padding="16px 20px" line-height="1.5">
          <tr>
            <td style="padding: 6px 0; font-size: 13px; color: #64748b; width: 40%">Quotation No</td>
            <td style="padding: 6px 0; font-size: 14px; font-weight: 600; color: #0f172a">{{ quotationNo }}</td>
          </tr>
          <tr>
            <td style="padding: 6px 0; font-size: 13px; color: #64748b">Deal</td>
            <td style="padding: 6px 0; font-size: 14px; color: #334155">{{ dealTitle }}</td>
          </tr>
          <tr>
            <td style="padding: 6px 0; font-size: 13px; color: #64748b">Customer</td>
            <td style="padding: 6px 0; font-size: 14px; color: #334155">{{ customerName }}</td>
          </tr>
          <tr>
            <td style="padding: 6px 0; font-size: 13px; color: #64748b">Sales Rep</td>
            <td style="padding: 6px 0; font-size: 14px; color: #334155">{{ salesRepName }}</td>
          </tr>
          <tr>
            <td style="padding: 6px 0; font-size: 13px; color: #64748b">Order Value</td>
            <td style="padding: 6px 0; font-size: 15px; font-weight: 700; color: #1e40af">{{ currency }} {{ totalAmount }}</td>
          </tr>
        </mj-table>

        <mj-spacer height="24px" />

        <mj-button
          background-color="#1e40af"
          color="#ffffff"
          font-size="15px"
          font-weight="600"
          border-radius="8px"
          padding="0"
          inner-padding="12px 28px"
          href="{{ fulfillmentLink }}"
          align="center"
        >
          Open Fulfillment Management
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 24px 32px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#9CA3AF">
          &copy; {{ currentYear }} {{ appName }}. Fulfillment Operations.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
